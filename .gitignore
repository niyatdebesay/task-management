# Ignore environment files
.env
.env.*

# Ignore node_modules for both frontend and backend
node_modules/
task-management-frontend/node_modules/
task-management-backend/node_modules/

# --- task-management-frontend specific ignores (merged from frontend .gitignore) ---
task-management-frontend/.pnp
task-management-frontend/.pnp.*
task-management-frontend/.yarn/*
!task-management-frontend/.yarn/patches
!task-management-frontend/.yarn/plugins
!task-management-frontend/.yarn/releases
!task-management-frontend/.yarn/versions
task-management-frontend/coverage
task-management-frontend/.next/
task-management-frontend/out/
task-management-frontend/build
task-management-frontend/.DS_Store
task-management-frontend/*.pem
task-management-frontend/npm-debug.log*
task-management-frontend/yarn-debug.log*
task-management-frontend/yarn-error.log*
task-management-frontend/.pnpm-debug.log*
task-management-frontend/.env*
task-management-frontend/.vercel
task-management-frontend/*.tsbuildinfo

# --- task-management-backend specific ignores (merged from backend .gitignore) ---
task-management-backend/dist
task-management-backend/build
task-management-backend/logs
task-management-backend/*.log
task-management-backend/npm-debug.log*
task-management-backend/pnpm-debug.log*
task-management-backend/yarn-debug.log*
task-management-backend/yarn-error.log*
task-management-backend/lerna-debug.log*
task-management-backend/.DS_Store
task-management-backend/coverage
task-management-backend/.nyc_output
task-management-backend/.idea
task-management-backend/.project
task-management-backend/.classpath
task-management-backend/.c9/
task-management-backend/*.launch
task-management-backend/.settings/
task-management-backend/*.sublime-workspace
task-management-backend/.vscode/*
!task-management-backend/.vscode/settings.json
!task-management-backend/.vscode/tasks.json
!task-management-backend/.vscode/launch.json
!task-management-backend/.vscode/extensions.json
task-management-backend/.env
task-management-backend/.env.development.local
task-management-backend/.env.test.local
task-management-backend/.env.production.local
task-management-backend/.env.local
task-management-backend/.temp
task-management-backend/.tmp
task-management-backend/pids
task-management-backend/*.pid
task-management-backend/*.seed
task-management-backend/*.pid.lock
task-management-backend/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
