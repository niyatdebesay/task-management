<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>New Task Assigned</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            background-color: #f4f4f4;
            padding: 20px;
            text-align: center;
        }
        .container {
            max-width: 500px;
            background: #ffffff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            margin: auto;
        }
        h2 {
            color: #333;
        }
        .task-details {
            text-align: left;
            margin-top: 20px;
        }
        .task-details p {
            margin: 5px 0;
        }
        .btn {
            display: inline-block;
            padding: 10px 15px;
            background: #007bff;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin-top: 15px;
        }
        .btn:hover {
            background: #0056b3;
        }
        .footer {
            margin-top: 20px;
            font-size: 12px;
            color: #777;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Hello, {{name}}!</h2>
        <p>You have been assigned a new task in the project <strong>{{projectName}}</strong>.</p>

        <div class="task-details">
            <p><strong>Task:</strong> {{taskTitle}}</p>
            <p><strong>Description:</strong> {{taskDescription}}</p>
            <p><strong>Due Date:</strong> {{dueDate}}</p>
        </div>

        {{!-- <a href="{{taskLink}}" class="btn">View Task</a> --}}

        <p class="footer">If you have any questions, please contact your project manager.</p>
    </div>
</body>
</html>
